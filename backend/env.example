# Contrato de configuración del TP capítulos 1 a 4 («la librería»).
#
# Copiar a `.env` (sin punto en este archivo) y completar los valores. En el
# servidor, pasar estas mismas variables con `--env-file <archivo fuera del
# repo>`; nunca con `-e` en la línea de comandos (quedan en el historial) ni
# dentro de la imagen.
#
# NO versionar `.env`. Ningún valor de este ejemplo es un secreto real.
#
# La aplicación NO lee una cadena de conexión completa: deriva la dirección de
# estas cinco variables con `sqlalchemy.engine.URL.create` y driver asincrónico,
# con esta forma:
#
#     postgresql+asyncpg://<usuario>:<clave>@<host>:<puerto>/<base>
#
# `URL.create` escapa usuario y clave, así que `@`, `:` o `%` no rompen la URL.
#
# Las cinco variables POSTGRES_* son obligatorias y sin valor por defecto: si
# falta una, la aplicación no arranca (fail-fast). Es lo que demuestra D-05.
#
# Dentro de un contenedor, `127.0.0.1` es el propio contenedor, no el servidor:
# si la base corre en el VPS, usar su dirección (o `host.docker.internal`
# junto con `--add-host=host.docker.internal:host-gateway`).
#
# El TP cap. 1-4 no tiene autenticación: no hay secreto de sesión ni de token.

POSTGRES_USER=libreria
POSTGRES_PASSWORD=cambiar_por_la_contrasena_local
POSTGRES_DB=libreria
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Opcionales.
POOL_SIZE=5
SQL_ECHO=false
