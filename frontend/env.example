# Variables de entorno del frontend (imagen Nginx del servicio App).
# Copiar como .env sólo para pruebas locales del contenedor; en Easypanel se
# cargan en la configuración del servicio. No versionar valores reales.

# Nombre interno del servicio backend y su puerto.
# Formato: host:puerto, sin http:// y sin barra final.
# Ejemplo: grupo-acgs_libreria-api:8000
API_UPSTREAM=
